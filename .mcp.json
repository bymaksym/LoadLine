{
    "mcpServers": {
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest",
                "--channel=stable",
                "--viewport=1440x900",
                "--no-usage-statistics",
                "--no-performance-crux"
            ]
        },
        "angular-cli": {
            "command": "npx",
            "args": ["-y", "@angular/cli", "mcp"]
        }
    }
}
