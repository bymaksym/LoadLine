{
    // Default formatter for every language
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,

    // Global code actions
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },

    // Per-language overrides (only the differences)
    "[scss]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "never",
            "source.fixAll.stylelint": "explicit"
        }
    },
    "[css]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "never",
            "source.fixAll.stylelint": "explicit"
        }
    },
    "[json]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "never"
        }
    },
    "[jsonc]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "never"
        }
    },

    // ESLint (flat config)
    "eslint.enable": true,
    "eslint.validate": ["javascript", "typescript", "html"],
    "eslint.lintTask.enable": true,
    "eslint.useFlatConfig": true,
    // The editor runs the type-aware rules too, the same as the `.ts` files of a commit: an
    // unawaited promise is worth seeing while it is being written, not at commit time.
    "eslint.options": { "overrideConfigFile": "eslint.typed.config.js" },

    // Stylelint
    "stylelint.enable": true,
    "stylelint.validate": ["css", "scss"],

    // Disable the built-in validators that conflict with stylelint
    "css.validate": false,
    "scss.validate": false,

    // Editor
    "files.eol": "\n",
    "editor.rulers": [120],
    "editor.tabSize": 4,

    // Extra
    "editor.formatOnPaste": false, // avoids lag when pasting large code
    "prettier.requireConfig": true, // only format when a Prettier config exists

    "npm.packageManager": "pnpm",

    // The root keeps the configs each tool looks for there (see "Tooling" in .github/CONTRIBUTING.md);
    // the explorer folds them under the file they belong with, so the root reads as the project.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .ncurc.js, knip.jsonc",
        "eslint.config.js": "eslint.typed.config.js, .htmlvalidate.mjs, .prettierignore",
        "tsconfig.json": "tsconfig.*.json",
        "README.md": "AGENTS.md, CLAUDE.md, CHANGELOG.md, LICENSE",
        ".gitignore": ".gitattributes, .editorconfig, .mcp.json"
    }
}
