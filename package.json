{
    "name": "@bymaksym/loadline",
    "version": "1.0.0",
    "description": "Weight per screen: what each screen of your app actually downloads.",
    "keywords": [
        "bundle-size",
        "bundle-analyzer",
        "performance",
        "angular",
        "vite",
        "esbuild",
        "code-splitting",
        "lazy-loading",
        "webperf",
        "cli"
    ],
    "license": "MIT",
    "author": "bymaksym",
    "homepage": "https://github.com/bymaksym/LoadLine#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bymaksym/LoadLine.git"
    },
    "bugs": {
        "url": "https://github.com/bymaksym/LoadLine/issues"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "packageManager": "pnpm@12.10.0",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "bin/",
        "dist/cli/",
        "loadline.html",
        "loadline.schema.json",
        "docs/HOW-IT-WORKS.md",
        "docs/CONFIG.md",
        "docs/CONFIG-REFERENCE.md",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./loadline.html": "./loadline.html",
        "./package.json": "./package.json"
    },
    "bin": {
        "loadline": "bin/loadline.js"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build && node scripts/inline-build.mjs",
        "build:cli": "tsc --project tsconfig.cli.json",
        "fonts": "node scripts/embed-fonts.mjs",
        "build:ci": "ng build --configuration production --stats-json",
        "test": "ng test --watch=false && pnpm run test:cli",
        "test:cli": "vitest run --dir cli",
        "test:watch": "ng test --watch=true",
        "test:coverage": "ng test --watch=false --coverage",
        "prepare": "npx only-allow@1.2.2 pnpm && (husky || exit 0) && node tooling/setup-git-merge-driver.mjs",
        "format": "prettier --write . --list-different",
        "format:check": "prettier --check .",
        "lint": "eslint --fix",
        "lint:ci": "eslint",
        "lint:types": "eslint --config eslint.typed.config.js",
        "lint:inspect": "pnpm dlx @eslint/config-inspector@3 --config eslint.typed.config.js",
        "lint:config": "node tooling/check-eslint-config.mjs",
        "config:check": "node tooling/check-config-found.mjs",
        "lint:prettier": "eslint-config-prettier src/main.ts src/app/app.html cli/main.ts tooling/check.mjs",
        "lint-styles:ci": "stylelint \"src/**/*.scss\"",
        "lint-styles:scope": "node tooling/check-styles.mjs",
        "lint:folders": "node tooling/check-folders.mjs",
        "lint-styles": "stylelint --fix \"src/**/*.scss\"",
        "fix-all": "node tooling/check.mjs --fix",
        "check": "node tooling/check.mjs",
        "check:all": "node tooling/check.mjs --all",
        "lint:all": "lint-staged",
        "typecheck": "tsc --noEmit --skipLibCheck --project tsconfig.app.json && tsc --noEmit --skipLibCheck --project tsconfig.cli.json && tsc --noEmit --skipLibCheck --project tsconfig.cli.spec.json && tsc --noEmit --skipLibCheck --project tsconfig.scripts.json",
        "knip": "node tooling/knip.mjs",
        "knip:deps": "node tooling/knip.mjs --include dependencies,unlisted,duplicates",
        "a11y:audit": "html-validate \"src/**/*.html\"",
        "spell:audit": "cspell lint --no-progress",
        "i18n:audit": "node tooling/validate-i18n.mjs",
        "duplicates:audit": "node tooling/validate-duplicates.mjs",
        "deps:check": "ncu",
        "deps:update": "ncu --interactive",
        "deps:update:deep": "pnpm update --depth 9999",
        "deps:audit": "pnpm audit --audit-level high",
        "deps:upgrade": "pnpm run deps:update && pnpm install && pnpm run deps:update:deep && pnpm dedupe && (pnpm run fix-all || exit 0) && node tooling/check.mjs --all",
        "secrets:scan": "secretlint --secretlintrc .config/secretlintrc.json --secretlintignore .config/secretlintignore --maskSecrets \"**/*\"",
        "self:check": "pnpm run build:ci && node scripts/inline-build.mjs && node bin/loadline.js dist/loadline-app/browser-stats.json --dist dist/loadline-app/browser --self-check && node bin/loadline.js dist/loadline-app/browser-stats.json --dist dist/loadline-app/browser --project . && node bin/loadline.js dist/loadline-app/browser --format summary",
        "loadline": "node bin/loadline.js",
        "rounds": "node tooling/rounds/rounds.mjs",
        "prepublishOnly": "tsc --project tsconfig.cli.json"
    },
    "prettier": {
        "bracketSpacing": true,
        "arrowParens": "avoid",
        "quoteProps": "as-needed",
        "semi": true,
        "singleQuote": true,
        "tabWidth": 4,
        "printWidth": 120,
        "bracketSameLine": false,
        "useTabs": false,
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "lint-staged": {
        "*.ts": [
            "eslint --config eslint.typed.config.js --fix",
            "prettier --write"
        ],
        "*.html": [
            "eslint --fix",
            "html-validate",
            "prettier --write"
        ],
        "*.scss": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{json,md,mjs,js}": [
            "prettier --write"
        ],
        "{*.md,src/app/core/i18n/*.ts,src/app/core/findings/text/finding-text.ts}": [
            "cspell lint --no-progress --no-must-find-files"
        ]
    },
    "devDependencies": {
        "@angular/build": "^22.2.1",
        "@angular/cli": "^22.2.1",
        "@angular/common": "^22.2.1",
        "@angular/compiler": "^22.2.1",
        "@angular/compiler-cli": "^22.2.1",
        "@angular/core": "^22.2.1",
        "@angular/platform-browser": "^22.2.1",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@cspell/dict-es-es": "^3.0.9",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
        "@types/node": "^26.6.4",
        "@vitest/eslint-plugin": "^1.6.27",
        "angular-eslint": "^22.5.0",
        "cspell": "^10.3.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-angular-modern": "^1.9.0",
        "eslint-plugin-baseline-js": "^0.7.4",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-regexp": "^3.3.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unicorn": "^77.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "html-validate": "^11.16.2",
        "html-validate-angular": "^9.0.0",
        "husky": "^9.1.7",
        "jscpd": "^5.4.0",
        "jsdom": "^30.1.2",
        "knip": "^6.39.0",
        "lint-staged": "^17.6.0",
        "npm-check-updates": "^23.1.0",
        "prettier": "^3.9.9",
        "rxjs": "~7.8.2",
        "secretlint": "^13.0.7",
        "stylelint": "^17.16.0",
        "stylelint-config-clean-order": "^10.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
        "stylelint-declaration-strict-value": "^1.12.1",
        "stylelint-high-performance-animation": "^2.0.0",
        "stylelint-plugin-use-baseline": "^1.4.6",
        "stylelint-scss": "^7.3.0",
        "stylelint-value-no-unknown-custom-properties": "^6.1.1",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^4.1.11"
    }
}
